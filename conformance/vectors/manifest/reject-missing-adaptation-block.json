{
  "id": "manifest/reject-missing-adaptation-block",
  "area": "manifest",
  "title": "A manifest with no adaptation block is rejected",
  "polarity": "negative",
  "requirement": {
    "document": "spec/lens-manifest.md",
    "section": "2",
    "text": "A conforming consumer MUST reject documents that fail schema validation."
  },
  "check": "schema.validate",
  "input": {
    "schema": "LensManifest",
    "document": {
      "lenspub": "0.1",
      "type": "LensManifest",
      "metadata": {
        "name": "No Adaptation",
        "lensVersion": "1.0.0"
      },
      "interpretation": {}
    }
  },
  "expect": {
    "valid": false,
    "failsOn": {
      "keyword": "required",
      "instancePath": ""
    }
  }
}
