{
  "id": "manifest/consumer-rejects-unknown-protocol-version",
  "area": "manifest",
  "title": "A manifest declaring protocol version 0.2 is rejected by the consumer",
  "polarity": "negative",
  "requirement": {
    "document": "spec/lenspub-protocol.md",
    "section": "8",
    "text": "Consumers MUST check it and MUST NOT process a document under the rules of a version other than the one it declares."
  },
  "role": "manifest-consumer",
  "check": "manifest.validate",
  "input": {
    "manifest": {
      "lenspub": "0.2",
      "type": "LensManifest",
      "metadata": {
        "name": "Conformance Base Lens",
        "lensVersion": "1.0.0"
      },
      "domains": [
        {
          "id": "health",
          "label": "Health"
        },
        {
          "id": "technology",
          "label": "Technology"
        }
      ],
      "interpretation": {
        "priorities": [
          {
            "topic": "local-first software",
            "weight": 0.9,
            "rationale": "I want to notice who keeps data on the device."
          }
        ],
        "sources": {
          "trusted": [
            {
              "origin": "example-journal.example",
              "note": "Editorially independent."
            }
          ],
          "requireProvenance": [
            "citations"
          ]
        },
        "presentation": {
          "summaries": "brief"
        }
      },
      "adaptation": {
        "defaultPolicy": "balanced"
      }
    }
  },
  "expect": {
    "accepted": false
  }
}
