{
  "id": "manifest/reject-unknown-protocol-version",
  "area": "manifest",
  "title": "A manifest declaring a protocol version other than 0.1 is rejected",
  "rationale": "Consumers MUST NOT process a document under the rules of a version other than the one it declares, so tolerating an unknown lenspub value is not forward compatibility — it is applying 0.1 semantics to a document that disclaimed them.",
  "polarity": "negative",
  "requirement": {
    "document": "spec/lenspub-protocol.md",
    "section": "8",
    "text": "Producers MUST set it; consumers MUST check it and MUST NOT process a document under the rules of a version other than the one it declares."
  },
  "check": "schema.validate",
  "input": {
    "schema": "LensManifest",
    "document": {
      "lenspub": "0.2",
      "type": "LensManifest",
      "metadata": {
        "name": "Conformance Base Lens",
        "lensVersion": "1.0.0"
      },
      "domains": [
        {
          "id": "health",
          "label": "Health"
        },
        {
          "id": "technology",
          "label": "Technology"
        }
      ],
      "interpretation": {
        "priorities": [
          {
            "topic": "local-first software",
            "weight": 0.9,
            "rationale": "I want to notice who keeps data on the device."
          }
        ],
        "sources": {
          "trusted": [
            {
              "origin": "example-journal.example",
              "note": "Editorially independent."
            }
          ],
          "requireProvenance": [
            "citations"
          ]
        },
        "presentation": {
          "summaries": "brief"
        }
      },
      "adaptation": {
        "defaultPolicy": "balanced"
      }
    }
  },
  "expect": {
    "valid": false,
    "failsOn": {
      "keyword": "const",
      "instancePath": "/lenspub"
    }
  }
}
