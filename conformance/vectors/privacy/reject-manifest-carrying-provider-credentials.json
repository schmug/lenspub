{
  "id": "privacy/reject-manifest-carrying-provider-credentials",
  "area": "privacy",
  "title": "A manifest carrying remote-inference credentials is rejected",
  "rationale": "Not a history leak but the same structural rule doing the work. A manifest is published; a credential inside one is published with it, and the opt-in it authorises is the user’s to revoke rather than the document’s to carry.",
  "polarity": "negative",
  "requirement": {
    "document": "security/privacy-model.md",
    "section": "3.1",
    "text": "Provider endpoints and credentials are device-local configuration and MUST NOT appear in the manifest.",
    "adr": "adr/0005-local-only-default.md"
  },
  "check": "schema.validate",
  "input": {
    "schema": "LensManifest",
    "document": {
      "lenspub": "0.1",
      "type": "LensManifest",
      "metadata": {
        "name": "Conformance Privacy Lens",
        "lensVersion": "1.0.0"
      },
      "domains": [
        {
          "id": "health",
          "label": "Health"
        }
      ],
      "interpretation": {
        "priorities": [
          {
            "topic": "local-first software",
            "weight": 0.9
          }
        ]
      },
      "adaptation": {
        "defaultPolicy": "balanced"
      },
      "privacy": {
        "remoteInference": {
          "allowed": true,
          "domains": [
            "health"
          ],
          "apiKey": "sk-example-not-a-real-key",
          "endpoint": "https://inference.example/v1"
        }
      }
    }
  },
  "expect": {
    "valid": false,
    "failsOn": {
      "keyword": "additionalProperties",
      "instancePath": "/privacy/remoteInference"
    }
  }
}
