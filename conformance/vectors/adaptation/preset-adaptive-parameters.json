{
  "id": "adaptation/preset-adaptive-parameters",
  "area": "adaptation",
  "title": "The adaptive preset resolves to its normative parameter values",
  "polarity": "positive",
  "requirement": {
    "document": "spec/adaptation-model.md",
    "section": "5",
    "text": "The five preset names — serialized in lowercase per the manifest schema — have the following normative values. adaptive: proposalFrequency 3, evidenceThreshold 3, autoAcceptCeiling trivial, exploratory proposals not permitted.",
    "adr": "adr/0010-adaptation-policies-parameterized.md"
  },
  "role": "adaptation-engine",
  "check": "policy.resolve",
  "input": {
    "manifest": {
      "lenspub": "0.1",
      "type": "LensManifest",
      "metadata": {
        "name": "Conformance Adaptation Lens",
        "lensVersion": "1.0.0"
      },
      "domains": [
        {
          "id": "health",
          "label": "Health"
        },
        {
          "id": "technology",
          "label": "Technology"
        }
      ],
      "interpretation": {},
      "adaptation": {
        "defaultPolicy": "adaptive"
      }
    }
  },
  "expect": {
    "proposalFrequency": 3,
    "evidenceThreshold": 3,
    "autoAcceptCeiling": "trivial",
    "exploratoryProposalsPermitted": false
  }
}
