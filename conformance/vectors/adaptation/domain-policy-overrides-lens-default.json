{
  "id": "adaptation/domain-policy-overrides-lens-default",
  "area": "adaptation",
  "title": "A per-domain policy governs content classified into that Domain Scope",
  "polarity": "positive",
  "requirement": {
    "document": "spec/adaptation-model.md",
    "section": "6",
    "text": "Per-domain policy overrides the lens-wide default: for content classified into a Domain Scope with an entry in adaptation.domainPolicies, that entry’s policy and parameters govern.",
    "adr": "adr/0010-adaptation-policies-parameterized.md"
  },
  "role": "adaptation-engine",
  "check": "policy.resolve",
  "input": {
    "manifest": {
      "lenspub": "0.1",
      "type": "LensManifest",
      "metadata": {
        "name": "Conformance Adaptation Lens",
        "lensVersion": "1.0.0"
      },
      "domains": [
        {
          "id": "health",
          "label": "Health"
        },
        {
          "id": "technology",
          "label": "Technology"
        }
      ],
      "interpretation": {},
      "adaptation": {
        "defaultPolicy": "explorer",
        "domainPolicies": [
          {
            "domain": "health",
            "policy": "locked"
          }
        ]
      }
    },
    "domains": [
      "health"
    ]
  },
  "expect": {
    "proposalFrequency": 0,
    "autoAcceptCeiling": "none",
    "exploratoryProposalsPermitted": false
  }
}
