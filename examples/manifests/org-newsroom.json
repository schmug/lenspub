{
  "lenspub": "0.1",
  "type": "LensManifest",
  "id": "https://meridianledger.example/lenspub/newsroom-standards.json",
  "metadata": {
    "name": "Meridian Ledger Newsroom Standards",
    "description": "An Organization Lens published by The Meridian Ledger, a fictional metropolitan newsroom, encoding the desk's sourcing standards for readers who want them applied to anything they read. Demonstrates an organization publisher, C2PA provenance requirements for imagery, always-visible reasoning traces, and a locked adaptation policy: this lens changes only through editorial review, applied as direct manual edits and released as new signed versions.",
    "lensVersion": "3.2.0",
    "created": "2025-08-18T09:00:00Z",
    "modified": "2026-05-27T13:20:00Z",
    "publisher": {
      "id": "did:web:meridianledger.example",
      "name": "The Meridian Ledger",
      "kind": "organization"
    },
    "language": "en"
  },
  "domains": [
    {
      "id": "elections",
      "label": "Elections",
      "description": "Campaigns, polling, and election administration."
    },
    {
      "id": "courts",
      "label": "Courts and legal affairs",
      "description": "Litigation, rulings, and court records."
    },
    {
      "id": "business",
      "label": "Business",
      "description": "Markets, companies, and economic policy."
    }
  ],
  "interpretation": {
    "priorities": [
      {
        "topic": "on-the-record sourcing",
        "weight": 0.9,
        "rationale": "Named sources with stated relationships to the story."
      },
      {
        "topic": "original documents",
        "weight": 0.8,
        "rationale": "Link the filing, the transcript, the disclosure - not a paraphrase of it."
      },
      {
        "topic": "anonymous single-source claims",
        "weight": -0.6,
        "rationale": "One unnamed source is a lead, not a story."
      },
      {
        "topic": "press-release churn",
        "weight": -0.5,
        "domains": ["business"],
        "rationale": "Corporate announcements republished without independent reporting."
      }
    ],
    "sources": {
      "trusted": [
        {
          "origin": "apnews.com",
          "weight": 0.8,
          "note": "Wire sourcing baseline."
        },
        {
          "origin": "courtlistener.com",
          "weight": 0.9,
          "note": "Primary court records."
        }
      ],
      "distrusted": [
        {
          "origin": "rapidwire-news.example",
          "weight": 0.8,
          "note": "Aggregator with a record of fabricated attribution."
        }
      ],
      "requireProvenance": [
        "c2pa",
        "citations",
        "author-identity",
        "publication-date"
      ]
    },
    "presentation": {
      "annotations": true,
      "summaries": "brief",
      "evidenceIndicators": true,
      "counterpoints": "on-request",
      "primarySourceExpansion": true,
      "explanationDisplay": "always"
    }
  },
  "adaptation": {
    "defaultPolicy": "locked"
  },
  "privacy": {
    "remoteInference": {
      "allowed": false
    }
  },
