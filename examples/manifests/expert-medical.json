  "id": "https://lenses.drrivera.example/clinical-evidence.json",
  "metadata": {
    "name": "Rivera Clinical Evidence Lens",
    "description": "A published Expert Lens from a practicing internist. Demonstrates the published-lens profile: a stable HTTPS id, a publisher block with a did:web identity and kind 'expert', heavy provenance requirements (citations, author identity, publication date, corroboration), conservative adaptation with explicit parameter overrides, local-only inference, and a W3C Data Integrity proof over the canonicalized manifest.",
    "lensVersion": "2.1.0",
    "created": "2025-11-03T14:00:00Z",
    "modified": "2026-06-30T11:58:00Z",
    "publisher": {
      "id": "did:web:drrivera.example",
      "name": "Dr. Maya Rivera, MD",
      "kind": "expert"
    },
    "language": "en"
  },
  "domains": [
    {
      "id": "clinical-medicine",
      "label": "Clinical medicine",
      "description": "Diagnosis, treatment, and clinical guidance."
    },
    {
      "id": "nutrition",
      "label": "Nutrition science",
      "description": "Diet, supplements, and metabolic health claims."
    },
    {
      "id": "public-health",
      "label": "Public health",
      "description": "Epidemiology, screening, and population-level guidance."
    }
  ],
  "interpretation": {
    "priorities": [
      {
        "topic": "randomized controlled trials",
        "weight": 0.9,
        "rationale": "RCTs and systematic reviews outrank observational claims and anecdote."
      },
      {
        "topic": "absolute risk reporting",
        "weight": 0.8,
        "rationale": "Relative-risk headlines without absolute numbers mislead patients."
      },
      {
        "topic": "preprint findings reported as settled",
        "weight": -0.7,
        "rationale": "Unreviewed results need visible caveats, not amplification."
      },
      {
        "topic": "supplement marketing claims",
        "weight": -0.9,
        "domains": ["nutrition"],
        "rationale": "Commercial claims dressed as research are the most common patient harm I see."
      }
    ],
    "sources": {
      "trusted": [
        {
          "origin": "pubmed.ncbi.nlm.nih.gov",
          "weight": 0.9,
          "note": "Indexed, peer-reviewed literature."
        },
        {
          "origin": "cochranelibrary.com",
          "weight": 1,
          "note": "Systematic reviews; the strongest available synthesis."
        },
        {
          "origin": "nejm.org",
          "weight": 0.9
        }
      ],
      "distrusted": [
        {
          "origin": "wellness-breakthrough.example",
          "weight": 1,
          "note": "Repeatedly promotes unproven therapies as cures."
        }
      ],
      "requireProvenance": [
        "citations",
        "author-identity",
        "publication-date",
        "corroboration"
      ]
    },
    "presentation": {
      "annotations": true,
      "summaries": "detailed",
      "evidenceIndicators": true,
      "counterpoints": "auto",
      "primarySourceExpansion": true,
      "explanationDisplay": "always"
    }
  },
  "adaptation": {
    "defaultPolicy": "conservative",
    "parameters": {
      "proposalFrequency": 1,
      "evidenceThreshold": 8,
      "autoAcceptCeiling": "none"
    }
  },
  "privacy": {
    "remoteInference": {
      "allowed": false
    }
  },
